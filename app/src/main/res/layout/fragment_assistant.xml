<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assistant_hint_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scrollAssistant"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAssistantHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="@string/assistant_hint_examples"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAssistantLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etAssistant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/assistant_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:maxLines="3" />

        <Button
            android:id="@+id/btnAssistantMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤" />

        <Button
            android:id="@+id/btnAssistantSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistant_send" />
    </LinearLayout>

</LinearLayout>
